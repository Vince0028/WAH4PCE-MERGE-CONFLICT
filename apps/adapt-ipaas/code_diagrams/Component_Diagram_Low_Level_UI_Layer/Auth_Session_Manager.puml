@startuml Auth_Session_Manager
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4 Level 4 - Code Diagram: Auth & Session Manager

note as N1
  Code level flow for Auth & Session Manager
  Files: src/middleware.ts & src/app/api/auth/login/route.ts
end note

Container_Boundary(auth_boundary, "Auth & Session Manager") {
    Component(login_route, "POST /api/auth/login\nroute.ts", "Next.js Route Handler", "Receives email and password. Authenticates via Supabase and bcrypt. Sets JWT cookie.")
    Component(supabase_client, "supabaseAdmin\n@/lib/supabase", "Supabase Client", "Queries 'app_users' table for user credentials.")
    Component(bcrypt_compare, "bcrypt.compare()", "bcryptjs", "Verifies password hash.")
    Component(jwt_sign, "new SignJWT()", "jose", "Generates HS256 signed JWT valid for 7 days.")
    
    Component(middleware, "middleware()\nmiddleware.ts", "Next.js Middleware", "Intercepts requests to verify JWT token presence and validity.")
    Component(jwt_verify, "jwtVerify()", "jose", "Verifies JWT signature and expiry. Redirects to /login if invalid.")
}

Rel(login_route, supabase_client, "1. Queries user by email/username", "Function Call")
Rel(login_route, bcrypt_compare, "2. Validates password", "Function Call")
Rel(login_route, jwt_sign, "3. Signs token", "Function Call")
Rel(login_route, middleware, "4. Sets 'auth_token' cookie", "HTTP Cookie")

Rel(middleware, jwt_verify, "Verifies cookie on protected routes", "Function Call")

@enduml
