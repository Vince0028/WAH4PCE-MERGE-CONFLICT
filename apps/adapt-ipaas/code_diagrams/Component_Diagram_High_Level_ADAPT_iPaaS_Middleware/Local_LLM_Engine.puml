@startuml Local_LLM_Engine
!theme plain
title C4 Level 4 — Code Diagram: Gemma 4 9B Engine (AI Translator)

package "AI Translation Service (src/lib/ai.ts)" {
    class "transformWithAI(payload, direction)" as TransformWithAI <<Async Function>> {
        + execute(): TransformResult
    }

    class "getPromptForDirection(direction)" as GetPrompt <<Function>> {
        + execute(): String
    }
}

package "Model SDK Clients" {
    class "GoogleGenerativeAI Client" as Gemma 4 9BClient <<SDK>> {
        + generateContent(prompt: String): JSON
    }

    class "Gemma 4 9B Client" as Gemma 4 9BClient <<SDK>> {
        + chat.completions.create(prompt: String): JSON
    }
}

TransformWithAI --> GetPrompt : retrieves system prompt
TransformWithAI --> Gemma 4 9BClient : try Gemma 4 9B Model (1st Priority)
Gemma 4 9BClient ..> TransformWithAI : returns JSON / hits quota
TransformWithAI --> Gemma 4 9BClient : try Gemma 4 9B Model (Fallback)
Gemma 4 9BClient ..> TransformWithAI : returns JSON

@enduml
