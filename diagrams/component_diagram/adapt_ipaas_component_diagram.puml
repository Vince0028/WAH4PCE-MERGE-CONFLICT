@startuml ADAPT_iPaaS_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

'Diagram Title
title Component Diagram for ADAPT iPaaS Middleware

'Actors
Person(admin, "WAH4PCE Admin", "Monitors system health and manages records")

'External Systems
System_Ext(ihomis, "iHOMIS", "DOH Legacy System")
System_Ext(wah, "WAH Hospital", "Modern System")
System_Ext(gemini, "Google Gemini AI", "Cloud AI Service")
System_Ext(groq, "Groq AI", "Backup AI Service")

Container_Boundary(adapt_ipaas, "ADAPT (Our Middleware)") {
    
    Container_Boundary(web_app, "Web Dashboard") {
        Component(dashboard, "View Transactions & Health", "React", "View all transactions and system health")
        Component(review, "Review Blocked Records", "React", "Review blocked records")
    }

    Container_Boundary(api_app, "Interoperability Routing & ADAPT Engine") {
        Component(step_receive, "Receive Incoming Record", "Golang", "Receive incoming health record")
        Component(step_consent, "Check Consent", "Golang", "Check if patient gave consent")
        Component(step_pending, "Save Pending Record", "Golang", "Save record as Pending")
        Component(step_ai, "AI Format Conversion", "Golang", "Send to AI for format conversion")
        Component(step_fallback, "Backup AI Converter", "Golang", "If AI is busy, try backup model")
        Component(step_validate, "Verify Converted Data", "Golang", "Verify the converted data is correct")
        Component(step_quarantine, "Quarantine Bad Records", "Golang", "Block bad records for admin review")
        Component(step_forward, "Forward Converted Data", "Golang", "Forward converted data to destination hospital")
        Component(step_log, "Transaction Logger", "Golang", "Save a log of what happened")
    }

    ComponentDb(log_db, "Transaction Logs", "MongoDB", "Only saves timestamps, status, and system names. NO patient health data is kept.")
}

'Relationships
Rel(ihomis, step_receive, "Sends patient record", "JSON")
Rel(wah, step_receive, "Sends patient record", "JSON")

Rel(step_receive, step_consent, "Triggers", "In-Process")
Rel(step_consent, step_pending, "If consent given", "In-Process")
Rel(step_consent, step_quarantine, "If no consent", "In-Process")
Rel(step_pending, step_ai, "Starts conversion", "In-Process")
Rel(step_ai, step_validate, "On success", "In-Process")
Rel(step_ai, step_fallback, "If AI busy", "In-Process")
Rel(step_validate, step_forward, "If correct", "In-Process")
Rel(step_validate, step_quarantine, "If bad data", "In-Process")
Rel(step_forward, step_log, "Logs result", "In-Process")
Rel(step_log, log_db, "Writes log", "MongoDB Driver")
Rel(step_quarantine, log_db, "Writes log", "MongoDB Driver")

Rel(step_forward, wah, "Delivers converted record", "HTTPS")
Rel(step_forward, ihomis, "Delivers converted record", "HTTPS")

Rel(step_ai, gemini, "Asks AI to convert", "HTTPS")
Rel(step_fallback, groq, "Backup AI", "HTTPS")

Rel(admin, dashboard, "Monitors system", "HTTPS")
Rel(admin, review, "Manages records", "HTTPS")
Rel(dashboard, log_db, "Reads logs", "MongoDB Driver")
Rel(review, step_quarantine, "Reviews blocked records", "HTTPS")

@enduml
