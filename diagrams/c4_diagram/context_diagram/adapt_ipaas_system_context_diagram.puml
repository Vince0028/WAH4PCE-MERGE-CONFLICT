@startuml ADAPT_iPaaS_System_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Level 1 — System Context Diagram — WAH4PCE Interoperability

' ===========================
' EXTERNAL System
' ===========================
System_Ext(ihomis, "DOH iHOMIS\n(External)", "Department of Health Integrated Hospital Operations Management Information System.\nLegacy system using HL7 v2 format.\nRequests, provides, and receives health data bidirectionally.")

' ===========================
' WAH4PCE SYSTEM BOUNDARY
' The entire system is shown at a high level.
' ===========================
System_Boundary(wah4pce, "WAH4PCE Interoperability System") {

    Person(admin, "WAH4PCE Admin", "IT administrator.\nAdministers and monitors the interoperability system.\nManages quarantined records.")

    System(wah, "WAH Hospital System\n(WAH4S, WAH4H, WAH4C)", "Internal Wide Area Health hospital sub-systems.\nStores and manages patient health records.\nSends and receives data in PH Core HL7 FHIR R4 format.\nBidirectional.")

    System(adapt, "ADAPT iPaaS", "AI-powered interoperability middleware.\nAccepts health data requests in HL7 v2 and FHIR R4.\nTranslates between formats using Local AI.\nValidates schema completeness and privacy consent (RA 10173).\nForwards transformed data to destination systems.")
}

' ===========================
' RELATIONSHIPS
' Bidirectional data flows with format details.
' ===========================

' Admin → ADAPT
Rel(admin, adapt, "Administers System\n(monitors dashboard, views logs,\nmanages quarantined records)", "HTTPS")

' DOH iHOMIS ↔ ADAPT (bidirectional)
Rel(ihomis, adapt, "Sends HL7 v2 patient records\nfor translation to FHIR R4.\nRequests FHIR R4 health data.", "POST /api/ingest\n[HL7 v2]")
Rel(adapt, ihomis, "Forwards translated records\n(FHIR R4 → HL7 v2 flat JSON)", "POST /api/webhook\n[HL7 v2 flat JSON]")

' WAH ↔ ADAPT (bidirectional)
Rel(wah, adapt, "Sends FHIR R4 Bundles\nfor translation to HL7 v2.\nManages health data.", "POST /api/ingest\n[FHIR R4 Bundle]")
Rel(adapt, wah, "Forwards translated records\n(HL7 v2 → FHIR R4 Bundle)", "POST /api/webhook\n[FHIR R4 Bundle]")

@enduml
