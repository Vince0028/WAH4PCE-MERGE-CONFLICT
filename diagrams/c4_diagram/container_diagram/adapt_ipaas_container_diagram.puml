@startuml WAH4PCE_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Level 2 — Container Diagram — WAH4PCE Interoperability System
caption Zooms into the WAH4PCE system boundary to show deployable applications, databases, and technology choices.

' ===========================
' EXTERNAL System (same as Context diagram)
' ===========================
System_Ext(ihomis, "DOH iHOMIS\n(External)", "DOH Legacy Hospital System.\nHL7 v2 format.\nBidirectional.")

' ===========================
' WAH4PCE SYSTEM BOUNDARY (zoomed in)
' ===========================
System_Boundary(wah4pce_boundary, "WAH4PCE Interoperability System") {

    ' --- Same actors as Context diagram ---
    Person(admin, "WAH4PCE Admin", "IT administrator.\nAdministers and monitors the system.")

    ' --- WAH Hospital (INTERNAL, same as Context but showing sub-systems) ---
    System_Boundary(wah_boundary, "WAH Hospital System (Internal)") {
        Container(wah_s, "WAH4S", "FHIR R4 Application", "WAH Sub-system S.\nSends/receives FHIR R4 Bundles.\nManages patient health records.")
        Container(wah_h, "WAH4H", "FHIR R4 Application", "WAH Sub-system H.\nSends/receives FHIR R4 Bundles.\nManages patient health records.")
        Container(wah_c, "WAH4C", "FHIR R4 Application", "WAH Sub-system C.\nSends/receives FHIR R4 Bundles.\nManages patient health records.")
    }

    ' --- ADAPT iPaaS (zoomed in — showing deployable containers) ---
    System_Boundary(adapt_boundary, "ADAPT iPaaS") {

        Container(web_dashboard, "Admin Dashboard", "Web Application\n(React / Web UI)", "UCD: Administer System\n\nProvides real-time monitoring dashboard, transaction history viewer, data mapper visualization, and quarantined record management.")

        Container(hl7_api, "HL7v2 Ingestion API", "Golang\nREST API Server", "UCD: Request Health Data (Example: HL7)\n\nExposes POST /api/ingest endpoint.\nAccepts HL7 v2 pipe-delimited messages.\nRoutes to processing pipeline.")

        Container(fhir_api, "FHIR R4 Ingestion API", "Golang\nREST API Server", "UCD: Request FHIR 4 Health Data\n\nExposes POST /api/ingest endpoint.\nAccepts FHIR R4 Transaction Bundles.\nRoutes to processing pipeline.")

        Container(consent_service, "Consent Validation Service", "Golang\nInternal Service", "UCD: Validate Privacy Consent\n\nEnforces RA 10173 (Data Privacy Act of 2012).\nBlocks and quarantines records without signed patient consent.")

        Container(data_manager, "Health Data Manager", "Golang\nInternal Service", "UCD: Manage Health Data\n\nManages transaction lifecycle (PENDING → TRANSFORMING → SUCCESS / QUARANTINED).\nStores raw payloads, audit trails.\nReads/writes to MongoDB.")

        Container(ai_engine, "AI Translation Engine", "Local AI\n(TBD — on-premise)", "UCD: Translate Data to/from PH Core HL7 FHIR R4 / HL7 v2\n\nBidirectional AI translation:\n• HL7 v2 → FHIR R4 Bundle\n• FHIR R4 → HL7 v2 flat JSON\nRuns locally, no cloud dependency.")

        Container(schema_validator, "Schema & Completeness Validator", "Golang\nInternal Service", "UCD: Validate Schema & Completeness\n\nValidates FHIR R4 Bundles for Patient, Encounter, Condition, PhilHealth ID.\nValidates HL7 v2 for required fields and vitals.")

        Container(forwarding_service, "Health Data Forwarding Service", "Golang\nWebhook Client", "UCD: Provide Health Data\n\nForwards transformed payloads to destination systems via POST /api/webhook.\nBidirectional: sends to iHOMIS (HL7 v2) and WAH (FHIR R4).")

        ContainerDb(mongodb, "MongoDB", "MongoDB\nDocument Database", "Stores:\n• Transaction logs\n• Raw & transformed payloads\n• Audit trails\n• Quarantined records\n\nEphemeral staging — no PHI stored permanently.")
    }
}

' ===========================
' RELATIONSHIPS
' ===========================

' Admin → Dashboard
Rel(admin, web_dashboard, "Monitors dashboard,\nviews logs, manages records", "HTTPS / Browser")

' Layout: WAH left → ADAPT center → iHOMIS right
wah_boundary -[hidden]R-> adapt_boundary
adapt_boundary -[hidden]R-> ihomis

' DOH iHOMIS ↔ ADAPT (bidirectional)
Rel_L(ihomis, hl7_api, "Sends HL7 v2 records", "POST /api/ingest\n[HL7 v2 pipe-delimited]")
Rel_L(ihomis, fhir_api, "Sends FHIR R4 requests", "POST /api/ingest\n[FHIR R4 Bundle]")
Rel_R(forwarding_service, ihomis, "Forwards translated HL7 v2", "POST /api/webhook\n[HL7 v2 flat JSON]")

' WAH ↔ ADAPT (bidirectional)
Rel_R(wah_s, fhir_api, "Sends FHIR R4 Bundle", "POST /api/ingest")
Rel_R(wah_h, fhir_api, "Sends FHIR R4 Bundle", "POST /api/ingest")
Rel_R(wah_c, fhir_api, "Sends FHIR R4 Bundle", "POST /api/ingest")
Rel_L(forwarding_service, wah_s, "Forwards FHIR R4 Bundle", "POST /api/webhook")
Rel_L(forwarding_service, wah_h, "Forwards FHIR R4 Bundle", "POST /api/webhook")
Rel_L(forwarding_service, wah_c, "Forwards FHIR R4 Bundle", "POST /api/webhook")

' Internal processing pipeline
Rel(hl7_api, consent_service, "1. Validates consent", "Internal call")
Rel(fhir_api, consent_service, "1. Validates consent", "Internal call")
Rel(consent_service, data_manager, "2. Stores as PENDING", "Internal call")
Rel(data_manager, ai_engine, "3. Triggers AI translation\nHL7 v2 ↔ FHIR R4", "Internal call")
Rel(ai_engine, schema_validator, "4. Validates output schema\n& completeness", "Internal call")
Rel(schema_validator, forwarding_service, "5. Forwards to destination", "Internal call")

' Data persistence
Rel(data_manager, mongodb, "Reads/Writes\ntransaction logs,\nraw & transformed payloads", "MongoDB Driver")

' Dashboard reads from manager
Rel(web_dashboard, data_manager, "Queries metrics,\ntransactions, logs", "Internal REST API")

@enduml
