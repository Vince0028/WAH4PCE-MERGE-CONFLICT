@startuml iHOMIS_System
' ============================================================
' iHOMIS - DOH Legacy Hospital System
' Simple and understandable
' ============================================================

skinparam backgroundColor #D6EAF8
skinparam defaultFontColor #333333
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing true

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 12
    RoundCorner 10
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #90CAF9
    FontColor #333333
    FontSize 11
}

skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #90CAF9
    FontColor #333333
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 10
}

title **iHOMIS - DOH Legacy Hospital System**

rectangle "iHOMIS" #E3F2FD {

    component "Save New\nPatient Record" as SAVE_PAGE
    component "View / Edit / Delete\nPatient Records" as RECORDS_PAGE
    component "Send Queue\n(Records waiting to send)" as SEND_PAGE
    component "Inbox\n(Received records from WAH)" as INBOX_PAGE

    component "Patient Records\nManager" as PATIENT_API
    component "HL7 v2 Message\nBuilder and Sender" as SEND_API
    component "Incoming Data\nReceiver" as WEBHOOK_API

    database "iHOMIS Patient\nDatabase" as IHOMIS_DB

    SAVE_PAGE --> PATIENT_API : creates
    RECORDS_PAGE --> PATIENT_API : views / edits
    RECORDS_PAGE --> SEND_PAGE : moves to queue
    SEND_PAGE --> SEND_API : sends to WAH
    INBOX_PAGE --> PATIENT_API : views received

    PATIENT_API --> IHOMIS_DB
    SEND_API --> IHOMIS_DB : gets record
    WEBHOOK_API --> IHOMIS_DB : saves received
}

note bottom of IHOMIS_DB
  **What it stores:**
  Patient name, PhilHealth ID,
  birthday, address, vitals,
  diagnosis, consent status

  **Data Format:** HL7 v2
  (Legacy format used by DOH)
end note

@enduml
