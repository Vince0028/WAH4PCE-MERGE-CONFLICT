@startuml Flow_WAH_to_DOH
' ============================================================
' Flow: WAH to DOH (Based on Figma Prototype Visualization)
' ============================================================

skinparam backgroundColor #D6EAF8
skinparam defaultFontColor #333333
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing true

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 12
    RoundCorner 10
}

skinparam arrow {
    Color #555555
    FontColor #555555
    FontSize 11
}

title **Prototype visualization WAH to DOH**

rectangle "WAH for Patients" as WAH_PATIENTS
rectangle "WAH for Hospitals" as WAH_HOSP
rectangle "WAH for Interoperability" as WAH_INTEROP
rectangle "Send data to\nexternal system" as SEND_EXT
rectangle "PAAS for External Interoperability" as PAAS
rectangle "Temporary Database" as TEMP_DB
rectangle "AI AUTOMATION LAYER" as AI_LAYER
rectangle "GETS CONVERTED TO" as CONVERT
rectangle "FHIR 4" as FHIR
rectangle "Verification Layer" as VERIFY
rectangle "Gemini 3.1 Flash Lite or Preview" as GEMINI
rectangle "Verification of waiver form" as WAIVER
rectangle "Verification of FHIR Format" as FORMAT
rectangle "SENDS THE FHIR FORMAT CONVERTED DATA" as SEND_FHIR
rectangle "Receive transformed data\nfrom external system" as RECEIVE_TRANS
rectangle "iHOMIS" as IHOMIS

' Main horizontal flow
WAH_PATIENTS -right-> WAH_HOSP : Doctor creates\nFHIR record
WAH_HOSP -right-> WAH_INTEROP : (1) Package FHIR R4\nBundle
WAH_INTEROP -right-> SEND_EXT : (2) Queue for dispatch
SEND_EXT -right-> PAAS : (3) POST /api/ingest\n(FHIR R4 JSON)
PAAS -right-> SEND_FHIR : (12) Dispatch flat JSON\nfor iHOMIS
SEND_FHIR -right-> RECEIVE_TRANS : (13) POST /api/webhook\n(to iHOMIS)
RECEIVE_TRANS -right-> IHOMIS : (14) Store record\n(Status=RECEIVED)

' Vertical AI Flow
PAAS -down-> TEMP_DB : (4) Consent Check & Log Transaction\n(No PHI stored permanently)
TEMP_DB -down-> AI_LAYER : (5) Route to Gemini\nfor Transformation
AI_LAYER -down-> CONVERT : (6) FHIR R4 → iHOMIS JSON\nTranslation
CONVERT -left-> GEMINI : using Google SDK
CONVERT -down-> FHIR : (7) Flatten rich FHIR\nresources to JSON
FHIR -right-> VERIFY : (8) Structural Validation
VERIFY -right-> GEMINI : using Fallback Chain\n(flash-lite to 2.0-flash)
GEMINI -down-> WAIVER : Check consent_signed
GEMINI -down-> FORMAT : Map Terminologies\n(LOINC, ICD-10)
VERIFY -up-> AI_LAYER : (9) Return Validation Result
AI_LAYER -up-> TEMP_DB : (10) Log Transformation\nSuccess/Quarantine
TEMP_DB -up-> PAAS : (11) Return Flat JSON Data

note right of TEMP_DB
  Note: We will train the AI
  based on the open source
  code and format of DOH
  system(iclinic/ihomic)
end note

@enduml
