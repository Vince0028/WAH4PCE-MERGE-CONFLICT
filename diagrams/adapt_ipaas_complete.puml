@startuml ADAPT_iPaaS_Complete
' ============================================================
' ADAPT iPaaS - What Our Group Built (Merge Conflict)
' Simple and understandable version
' ============================================================

skinparam backgroundColor #D6EAF8
skinparam defaultFontColor #333333
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing true

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 12
    RoundCorner 10
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 11
}

skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 11
}

skinparam arrow {
    Color #555555
    FontColor #555555
    FontSize 10
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 10
}

title **ADAPT iPaaS - What Our Group Built**\nAutomated Data Processing and Transformation\nTeam Merge Conflict | AY 2025-2026

' -- External Systems (NOT ours) --
rectangle "iHOMIS\n(DOH Legacy System)" as IHOMIS #E3F2FD
rectangle "WAH Hospital\n(Modern System)" as WAH #E8F5E9
rectangle "Google Gemini AI" as GEMINI #F3E5F5
rectangle "Groq AI\n(Backup)" as GROQ #FFF3E0

actor "WAH4PCE Admin" as ADMIN

' -- ADAPT iPaaS System Boundary --
rectangle "ADAPT iPaaS (Our Middleware)" as ADAPT #F3E5F5 {

    rectangle "Receiving Data" {
        component "Receive incoming\nhealth record" as STEP_RECEIVE
        component "Check if patient\ngave consent" as STEP_CONSENT
        component "Save record\nas Pending" as STEP_PENDING
    }

    rectangle "AI Conversion" {
        component "Send to AI for\nformat conversion" as STEP_AI
        component "If AI is busy,\ntry backup model" as STEP_FALLBACK
    }

    rectangle "Checking Results" {
        component "Verify the converted\ndata is correct" as STEP_VALIDATE
        component "Block bad records\nfor admin review" as STEP_QUARANTINE
    }

    rectangle "Sending Results" {
        component "Forward converted data\nto destination hospital" as STEP_FORWARD
        component "Save a log of\nwhat happened" as STEP_LOG
    }

    rectangle "Admin Dashboard" {
        component "View all transactions\nand system health" as DASHBOARD
        component "Review blocked\nrecords" as REVIEW
    }

    database "Transaction Logs\n(No patient data stored)" as LOG_DB
}

' -- Pipeline Flow --
STEP_RECEIVE -down-> STEP_CONSENT
STEP_CONSENT -down-> STEP_PENDING
STEP_PENDING -down-> STEP_AI
STEP_AI -down-> STEP_VALIDATE
STEP_VALIDATE -down-> STEP_FORWARD
STEP_FORWARD -down-> STEP_LOG
STEP_LOG -down-> LOG_DB

' -- Side flows --
STEP_CONSENT -right-> STEP_QUARANTINE : no consent
STEP_AI -right-> STEP_FALLBACK : AI busy
STEP_VALIDATE -right-> STEP_QUARANTINE : bad data

' -- Dashboard --
DASHBOARD -down-> LOG_DB
REVIEW -down-> STEP_QUARANTINE

' -- External Connections --
IHOMIS -right-> STEP_RECEIVE : sends patient\nrecord
WAH -left-> STEP_RECEIVE : sends patient\nrecord
STEP_FORWARD -right-> WAH : delivers\nconverted record
STEP_FORWARD -left-> IHOMIS : delivers\nconverted record

STEP_AI -down-> GEMINI : asks AI to convert
STEP_FALLBACK -down-> GROQ : backup AI

ADMIN -down-> DASHBOARD : monitors system

note bottom of LOG_DB
  Only saves: timestamps, status,
  and system names.
  NO patient health data is kept.
end note

@enduml
