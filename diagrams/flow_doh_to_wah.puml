@startuml Flow_DOH_to_WAH
' ============================================================
' Flow: DOH to WAH (Based on Figma Prototype Visualization)
' ============================================================

skinparam backgroundColor #D6EAF8
skinparam defaultFontColor #333333
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing true

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #333333
    FontSize 12
    RoundCorner 10
}

skinparam arrow {
    Color #555555
    FontColor #555555
    FontSize 11
}

title **Prototype visualization DOH to WAH**

rectangle "iHOMIS\n(Legacy System)" as IHOMIS
rectangle "Send data to\nexternal system" as SEND_EXT
rectangle "PAAS for External Interoperability" as PAAS
rectangle "Temporary Database" as TEMP_DB
rectangle "AI AUTOMATION LAYER" as AI_LAYER
rectangle "GETS CONVERTED TO" as CONVERT
rectangle "HL7 FHIR" as FHIR
rectangle "Verification Layer" as VERIFY
rectangle "Gemini 3.1 Flash Lite or Preview" as GEMINI
rectangle "Verification of waiver form" as WAIVER
rectangle "Verification of FHIR Format" as FORMAT
rectangle "SENDS THE FHIR FORMAT CONVERTED DATA" as SEND_FHIR
rectangle "Receive transformed data\nfrom external system" as RECEIVE_TRANS
rectangle "WAH for Interoperability" as WAH_INTEROP
rectangle "WAH for Hospitals" as WAH_HOSP
rectangle "WAH for Patients" as WAH_PATIENTS

' Main horizontal flow
IHOMIS -right-> SEND_EXT : (1) Build HL7 v2\n(MSH|PID|PV1|OBX|DG1|RF1)
SEND_EXT -right-> PAAS : (2) POST /api/ingest\n(JSON payload)
PAAS -right-> SEND_FHIR : (11) Dispatch valid\nFHIR R4 Bundle
SEND_FHIR -right-> RECEIVE_TRANS : (12) POST /api/webhook\n(to WAH)
RECEIVE_TRANS -right-> WAH_INTEROP : (13) Store record\n(Status=RECEIVED)
WAH_INTEROP -right-> WAH_HOSP : (14) Doctor reviews\nin Inbox
WAH_HOSP -right-> WAH_PATIENTS : (15) Patient Data\nUpdated

' Vertical AI Flow
PAAS -down-> TEMP_DB : (3) Consent Check & Log Transaction\n(No PHI stored permanently)
TEMP_DB -down-> AI_LAYER : (4) Route to Gemini\nfor Transformation
AI_LAYER -down-> CONVERT : (5) HL7 v2 → FHIR R4\nTranslation
CONVERT -left-> GEMINI : using Google SDK
CONVERT -down-> FHIR : (6) Generates\nFHIR Transaction Bundle
FHIR -right-> VERIFY : (7) Validate Structure\n& Mandatory Fields
VERIFY -right-> GEMINI : using Fallback Chain\n(flash-lite to 2.0-flash)
GEMINI -down-> WAIVER : Check consent_signed
GEMINI -down-> FORMAT : Apply PH Core Profiles
VERIFY -up-> AI_LAYER : (8) Return Validation Result
AI_LAYER -up-> TEMP_DB : (9) Log Transformation\nSuccess/Quarantine
TEMP_DB -up-> PAAS : (10) Return FHIR R4 Data

note right of TEMP_DB
  Note: We will train the AI
  based on the PH core format
  the Batch 1 gave
end note

@enduml
